on:sticky;top:0;z-index:20;height:auto;flex-direction:row;align-items:center;gap:12px;padding:11px 16px;border-right:0;border-bottom:var(--line);overflow-x:auto;white-space:nowrap}\n  .toc-title{font-size:.66rem}\n  .toc-list{flex-direction:row;gap:15px;margin-left:4px}\n  .toc-list a{padding:2px 0;font-size:.86rem;border-bottom:0}\n  .toc-note{display:none}\n  .section{scroll-margin-top:58px}\n}\n@media (max-width:720px){\n  .grid-3,.grid-2{grid-template-columns:1fr}\n}\n@media (max-width:520px){\n  .steps li{padding:46px 20px 20px}\n  .steps li::before{top:15px;left:20px}\n  .plan{padding:20px}\n  .plan.is-featured{box-shadow:6px 6px 0 var(--violet)}\n}\n</style><div class=\"shell\">\n  <nav class=\"toc\" aria-label=\"页面目录\">\n    <p class=\"toc-title\">目 录</p>\n    <ol class=\"toc-list\">\n      <li><a href=\"#overview\"><span>01</span>概览</a></li>\n      <li><a href=\"#plans\"><span>02</span>套餐</a></li>\n      <li><a href=\"#clients\"><span>03</span>客户端</a></li>\n      <li><a href=\"#guide\"><span>04</span>使用说明</a></li>\n      <li><a href=\"#faq\"><span>05</span>常见问题</a></li>\n    </ol>\n    <p class=\"toc-note\">本页只做信息整理，不含支付入口，也不提供安装包下载直链。</p>\n  </nav>\n\n  <main>\n    <section class=\"hero\" id=\"top\">\n      <div class=\"band band-a\">\n        <p class=\"kicker\">机场服务信息整理</p>\n        <h1>猪の</h1>\n      </div>\n      <div class=\"band band-b\">\n        <p class=\"lead\">如果你只想搞清楚三件事——多少钱、能几台设备、怎么连——这一页从上往下读三分钟就够了。猪の 的三档套餐、客户端获取方式和使用步骤都写在下面，没有藏起来的部分。</p>\n      </div>\n      <div class=\"band band-c\">\n        <ul class=\"band-facts\">\n          <li><strong>3</strong>档订阅套餐</li>\n          <li><strong>100–1000</strong>GB 每月流量</li>\n          <li><strong>3–20</strong>台设备同时在线</li>\n        </ul>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"overview\">\n      <div class=\"section-head\">\n        <p class=\"section-no\">01 / 概览</p>\n        <h2>先花一分钟，弄清楚猪の是什么</h2>\n      </div>\n      <p class=\"prose\">猪の 是一个以订阅套餐形式提供服务的机场品牌：按月计费，按每月流量和同时在线设备数量分成基础版、旗舰版、团队版三档。这份页面把三档套餐的价格、权益，以及客户端怎么获取、连上之前要做什么，一次性整理在一起，省得你来回翻聊天记录和截图。</p>\n      <p class=\"prose\">需要提前说明的是：本页只做信息整理，页面上没有支付入口，也没有安装包的下载直链。所有价格与权益，请以你实际订阅时看到的内容为准。</p>\n      <div class=\"grid-3\">\n        <article class=\"card\">\n          <h3>套餐讲清楚</h3>\n          <p>三档订阅的月付、年付价格，流量额度和设备数量并排摆出来，不用在几个页面之间来回对比。</p>\n        </article>\n        <article class=\"card\">\n          <h3>客户端好找</h3>\n          <p>客户端从哪里获取、安装前后各要注意什么，集中写在客户端区块里，避免去陌生站点拿安装包。</p>\n        </article>\n        <article class=\"card\">\n          <h3>说明写全</h3>\n          <p>从挑套餐到连上节点一共六步，每一步都写清楚动作和容易踩的坑，照着做基本不会卡住。</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"plans\">\n      <div class=\"section-head\">\n        <p class=\"section-no\">02 / 套餐</p>\n        <h2>三档套餐，价格和权益一次摆清楚</h2>\n        <p class=\"section-sub\">月付和年付都可以。三档的年付价格，正好都是各自月付价乘以十，常用的话年付更省一点。选哪一档，主要看每月流量和同时在线的设备数量。</p>\n      </div>\n      <div class=\"plans\">\n        <article class=\"plan\">\n          <div class=\"plan-top\">\n            <h3>基础版</h3>\n            <p class=\"plan-price\"><span class=\"num\">¥15</span><span class=\"unit\">/月</span></p>\n          </div>\n          <p class=\"plan-annual\">按年付仅需 ¥150/年</p>\n          <ul class=\"plan-features\">\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <p class=\"plan-fit\">适合一个人日常用：刷网页、看剧、偶尔下载，手头设备不超过三台。</p>\n        </article>\n        <article class=\"plan is-featured\">\n          <div class=\"plan-top\">\n            <h3>旗舰版 <span class=\"badge\">推荐</span></h3>\n            <p class=\"plan-price\"><span class=\"num\">¥35</span><span class=\"unit\">/月</span></p>\n          </div>\n          <p class=\"plan-annual\">按年付仅需 ¥350/年</p>\n          <ul class=\"plan-features\">\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <p class=\"plan-fit\">适合手机、平板、电脑一起用，又在意流媒体和游戏延迟的人。</p>\n        </article>\n        <article class=\"plan\">\n          <div class=\"plan-top\">\n            <h3>团队版</h3>\n            <p class=\"plan-price\"><span class=\"num\">¥85</span><span class=\"unit\">/月</span></p>\n          </div>\n          <p class=\"plan-annual\">按年付仅需 ¥850/年</p>\n          <ul class=\"plan-features\">\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <p class=\"plan-fit\">适合小团队或工作室：人多、设备多，还需要有人对接处理问题。</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"clients\">\n      <div class=\"section-head\">\n        <p class=\"section-no\">03 / 客户端</p>\n        <h2>客户端怎么拿，先看这几句</h2>\n      </div>\n      <p class=\"prose\">本页不提供安装包，也不放下载直链。你需要的客户端和订阅信息，请以订阅后实际收到的指引为准。遇到来路不明的安装包、要求额外付费的“加速器”，建议直接跳过——装错东西，比慢一点更麻烦。</p>\n      <div class=\"grid-2\">\n        <article class=\"card\">\n          <h3>安装前先核对来源</h3>\n          <p>拿到安装包之后，先确认它和你收到的指引一致，再检查设备系统版本能不能正常安装，避免装上被改过的版本。</p>\n        </article>\n        <article class=\"card\">\n          <h3>订阅信息当钥匙保管</h3>\n          <p>订阅地址或配置信息相当于账号钥匙。复制时注意别带上多余空格，也别随手转发到群里。</p>\n        </article>\n        <article class=\"card\">\n          <h3>留意设备数量上限</h3>\n          <p>基础版 3 台、旗舰版 5 台、团队版 20 台。同时在线设备超过上限会影响正常使用，建议按实际设备数选档。</p>\n        </article>\n        <article class=\"card\">\n          <h3>连接异常按顺序排查</h3>\n          <p>先换节点再重连，然后检查订阅是否需要更新，最后再考虑重装客户端。这个顺序能解决大部分临时问题。</p>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"guide\">\n      <div class=\"section-head\">\n        <p class=\"section-no\">04 / 使用说明</p>\n        <h2>从挑套餐到连上，六步走完</h2>\n      </div>\n      <ol class=\"steps\">\n        <li>\n          <h3>挑一档套餐</h3>\n          <p>先看每月流量够不够，再看同时在线的设备数量。一个人用基础版就够；设备和流媒体需求多，旗舰版更稳；多人共用选团队版。</p>\n        </li>\n        <li>\n          <h3>领取订阅信息</h3>\n          <p>订阅完成后，按你收到的指引获取订阅地址或配置信息。先把内容完整复制保存好，再关掉页面。</p>\n        </li>\n        <li>\n          <h3>安装对应客户端</h3>\n          <p>按设备系统选择对应的客户端，从你收到的渠道获取安装包。装好之后先别急着连接，把下一步做完再说。</p>\n        </li>\n        <li>\n          <h3>导入订阅</h3>\n          <p>在客户端里找到添加订阅或导入配置的入口，粘贴刚才保存的订阅地址，保存后手动更新一次节点列表。</p>\n        </li>\n        <li>\n          <h3>选节点并连接</h3>\n          <p>优先选延迟数字更低的节点；如果连不上，换一个节点重试，多试两个通常就能判断是节点问题还是配置问题。</p>\n        </li>\n        <li>\n          <h3>日常维护</h3>\n          <p>定期更新客户端和订阅，留意套餐到期时间与流量使用情况。设备换新时，在新设备上重新导入同一份订阅即可。</p>\n        </li>\n      </ol>\n    </section>\n\n    <section class=\"section\" id=\"faq\">\n      <div class=\"section-head\">\n        <p class=\"section-no\">05 / 常见问题</p>\n        <h2>你可能想问的几件事</h2>\n      </div>\n      <div class=\"faq\">\n        <details>\n          <summary>猪の 是什么？</summary>\n          <div class=\"answer\"><p>猪の 是一个以订阅套餐形式提供服务的机场品牌，套餐按每月流量和同时在线设备数量分成基础版、旗舰版、团队版三档。本页把套餐、客户端和使用说明整理在一起，方便你在订阅之前先看清楚。</p></div>\n        </details>\n        <details>\n          <summary>三档套餐该怎么选？</summary>\n          <div class=\"answer\"><p>看两个数字就够了：每月流量和同时在线设备数量。100GB 流量配 3 台设备是基础版，300GB 配 5 台是旗舰版，1000GB 配 20 台是团队版。需要给多人分设备用，就直接看团队版。</p></div>\n        </details>\n        <details>\n          <summary>年付真的划算吗？</summary>\n          <div class=\"answer\"><p>三档的年付价格分别是 ¥150、¥350、¥850，正好都是各自月付价乘以十。也就是说，年付相当于用十个月的价钱用满十二个月，常用的话确实比月付省。</p></div>\n        </details>\n        <details>\n          <summary>可以同时在几台设备上使用？</summary>\n          <div class=\"answer\"><p>基础版 3 台、旗舰版 5 台、团队版 20 台同时在线。这里说的是“同时在线”的数量，不是一共能装几台；设备开得越多越容易超限，不用的时候记得下线。</p></div>\n        </details>\n        <details>\n          <summary>流量用完了会怎样？</summary>\n          <div class=\"answer\"><p>本页没有列出流量用尽后的具体处理规则，实际以你订阅时收到的说明为准。选档时建议留一点余量，比如每月大约用到 80GB，就选 100GB 那一档。</p></div>\n        </details>\n        <details>\n          <summary>客户端在哪里下载？</summary>\n          <div class=\"answer\"><p>本页不提供安装包和下载直链。请以订阅后收到的指引为准获取客户端，不要从来路不明的第三方站点下载，也不要在陌生页面输入订阅信息。</p></div>\n        </details>\n        <details>\n          <summary>支持哪些设备系统？</summary>\n          <div class=\"answer\"><p>本页没有列出具体的系统支持清单。安装前请先确认你的设备能安装对应客户端，再决定下单，免得买完才发现装不上。</p></div>\n        </details>\n        <details>\n          <summary>可以先试用再买吗？</summary>\n          <div class=\"answer\"><p>本页没有提供试用相关信息，是否有试用、试用多久，请在订阅前向服务方确认。三档套餐都支持按月付，也可以先按月付用一个月，觉得合适再转年付。</p></div>\n        </details>\n        <details>\n          <summary>换设备需要重新配置吗？</summary>\n          <div class=\"answer\"><p>在新设备上安装客户端，导入同一份订阅信息，更新节点列表就能用。记得先把旧设备上不用的连接关掉，别让同时在线数量超限。</p></div>\n        </details>\n        <details>\n          <summary>遇到问题找谁？</summary>\n          <div class=\"answer\"><p>旗舰版包含 7×24 优先工单支持，团队版有专属客户经理对接。基础版的支持方式本页没有列出，以你订阅时收到的说明为准。提问题时附上设备系统、客户端版本和报错截图，处理会更快。</p></div>\n        </details>\n      </div>\n    </section>\n  </main>\n</div>\n\n<footer>\n  <p class=\"foot-brand\">猪の</p>\n  <p>本页为猪の机场套餐与使用信息整理页，不提供支付、下载与账号服务。文中价格与权益，以你订阅时实际看到的内容为准。</p>\n  <p><a href=\"#top\">回到顶部 ↑</a></p>\n</footer>",
